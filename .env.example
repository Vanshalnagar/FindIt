# Root .env used by docker-compose.yml only.
# Copy to .env and change values:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# For local (non-Docker) development use server/.env instead.

# REQUIRED in any shared/production setup: use a long random string
SESSION_SECRET=change-me

# Host port where the web UI is published
CLIENT_PORT=8080

# Origin the browser uses to reach the app (used for the Origin check and CORS)
CLIENT_ORIGIN=http://localhost:8080

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

NODE_ENV=production
